# Copy to .env and fill in. .env is gitignored.
REDOWEBS_OPENROUTER_API_KEY=

# Google OAuth Client ID (Identity Services ID-token flow -- no client secret needed)
REDOWEBS_GOOGLE_CLIENT_ID=

# Secret used to sign our own access/refresh JWTs -- generate with e.g. `openssl rand -hex 32`
REDOWEBS_JWT_SECRET_KEY=
