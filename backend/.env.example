# Copy to .env and fill in. .env is gitignored.
REDOWEBS_OPENROUTER_API_KEY=

# Google OAuth client (server-side authorization-code redirect flow).
# Both client ID and secret come from the same Google Cloud Console OAuth
# client (Application type: Web application). The exact redirect URI below
# must be registered there under "Authorized redirect URIs".
REDOWEBS_GOOGLE_CLIENT_ID=
REDOWEBS_GOOGLE_CLIENT_SECRET=
REDOWEBS_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8123/api/v1/auth/google/callback

# Where the backend redirects the browser after a successful/failed login.
REDOWEBS_FRONTEND_URL=http://localhost:4200

# Secret used to sign our own JWTs -- generate with e.g. `openssl rand -hex 32`
REDOWEBS_JWT_SECRET_KEY=

# Payments (PayPal) -- see docs/paypal-payments-plan.md
# Local testing without PayPal: set REDOWEBS_PAYMENTS_MODE=mock and every
# payment succeeds instantly (only honoured while REDOWEBS_FRONTEND_URL is
# localhost). Leave it as "paypal" for real/sandbox payments.
REDOWEBS_PAYMENTS_MODE=paypal
REDOWEBS_PAYPAL_CLIENT_ID=
REDOWEBS_PAYPAL_CLIENT_SECRET=
REDOWEBS_PAYPAL_ENV=sandbox
REDOWEBS_PAYPAL_WEBHOOK_ID=
# Pending-purchase reconciler (queue worker): re-checks PayPal purchases still
# pending after MIN_AGE, gives up after MAX_AGE (admin Re-check after that).
# REDOWEBS_BILLING_RECONCILE_INTERVAL_MINUTES=10
# REDOWEBS_BILLING_RECONCILE_MIN_AGE_MINUTES=5
# REDOWEBS_BILLING_RECONCILE_MAX_AGE_HOURS=72
